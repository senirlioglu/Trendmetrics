# ============================================
# TrendMetrics Environment Configuration
# ============================================

# Server
PORT=3001
NODE_ENV=development

# CORS (comma-separated origins, leave empty for open CORS in dev)
CORS_ORIGINS=

# PostgreSQL
DATABASE_URL=postgresql://trendmetrics:trendmetrics@localhost:5432/trendmetrics
DB_POOL_MIN=2
DB_POOL_MAX=10

# Firebase Admin (Backend)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Client (Frontend - VITE_ prefix)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000:web:000

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_API_KEY=your-gemini-api-key

# AI Model Configuration (do not hardcode specific versions)
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Optional: YouTube Data API (enables official API connector)
YOUTUBE_API_KEY=

# Redis (optional - falls back to in-memory queue)
REDIS_URL=

# Admin UIDs (comma-separated Firebase UIDs for admin access)
ADMIN_UIDS=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Credit Configuration
CREDIT_DEEP_ANALYSIS_COST=3.00
CREDIT_FORCE_REFRESH_COST=1.00
CREDIT_DAILY_REPORT_COST=2.00
CREDIT_SIGNUP_BONUS=10.00

# Cache TTLs
CACHE_HOT_TTL_MINUTES=15
CACHE_DAILY_TTL_HOURS=24
CACHE_HISTORY_TTL_DAYS=7

# Logging
LOG_LEVEL=debug

# Frontend (set in Vercel environment variables)
# VITE_API_BASE_URL=https://your-backend.up.railway.app/api
